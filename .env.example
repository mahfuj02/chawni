# Copy to .env.local (git-ignored). Never commit real values.

# Public site URL (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email via Resend. If RESEND_API_KEY is empty, submissions are logged to the console.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@example.com
CONTACT_FROM_EMAIL=Chawni Website <onboarding@resend.dev>
